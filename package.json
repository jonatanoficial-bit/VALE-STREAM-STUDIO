{
  "name": "vale-stream-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Estúdio local de aulas, gravação e transmissões para Windows.",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @vale/desktop dev",
    "build": "pnpm --filter @vale/desktop build",
    "lint": "pnpm --filter @vale/desktop lint",
    "test": "pnpm --filter @vale/desktop test",
    "typecheck": "pnpm --filter @vale/desktop typecheck",
    "dist": "pnpm --filter @vale/desktop dist"
  },
  "workspaces": [
    "apps/*"
  ]
}
